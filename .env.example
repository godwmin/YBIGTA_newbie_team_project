# ==========================================
# AI Agent 과제 환경변수 Template
# ==========================================

# 1. DB 설정 (AWS RDS / MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crypto_db

# 2. 역할별 DB 계정
COLLECTOR_DB_USER=collector_user
COLLECTOR_DB_PASSWORD=
MCP_DB_USER=mcp_user
MCP_DB_PASSWORD=

# 3. MCP Server 설정
# 로컬: http://localhost:8000/mcp
# 배포: https://<mcp-domain>/mcp
MCP_SERVER_URL=http://localhost:8000/mcp
MCP_AUTH_TOKEN=

# 4. LLM API Key (Vercel Server Side 전용)
OPENAI_API_KEY=
