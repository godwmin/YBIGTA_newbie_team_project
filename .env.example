# ==========================================
# AI Agent 과제 환경변수 Template
# ==========================================
#
# 중요: 이 파일에는 절대 실제 값을 넣지 않는다. (커밋되는 파일)
#
# 더 중요: 아래 값들을 하나의 .env에 담아 모두가 공유하지 않는다.
#         컴포넌트마다 "그 컴포넌트에 필요한 값만" 주입한다.
#
#   EC2 /opt/mcp/.env          -> MCP Server 컨테이너   (mcp_user, 읽기 전용)
#   EC2 /opt/mcp/collector.env -> Collector 컨테이너    (collector_user, 쓰기)
#   Vercel 환경변수 (Server)   -> Next.js Route Handler

# 1. DB 설정 (AWS RDS / MySQL)
#    로컬 테스트: localhost
#    배포 시    : 팀원3이 공유하는 RDS 엔드포인트
#    RDS는 Private Subnet에 있어 VPC 밖(개인 노트북)에서는 접속되지 않는 것이 정상이다.
#    노트북에서 붙어야 한다면 EC2를 경유하는 SSH 터널을 쓴다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crypto_db

# 2. 역할별 DB 계정 (권한 분리 — infra/sql/01_db_users.sql 에서 생성)
#    collector_user : SELECT, INSERT, UPDATE  (DELETE/DDL 없음)
#    mcp_user       : SELECT 만
COLLECTOR_DB_USER=collector_user
COLLECTOR_DB_PASSWORD=
MCP_DB_USER=mcp_user
MCP_DB_PASSWORD=

# 3. MCP Server 설정
#    요청 헤더: Authorization: Bearer <MCP_AUTH_TOKEN>
#
#    [주의] 배포 주소에 포트 8000을 붙이지 않는다.
#      8000번은 Security Group에서 인터넷에 열지 않으며(과제 채점 항목),
#      컨테이너도 127.0.0.1 에만 바인딩된다.
#      EC2의 Nginx가 80 -> 127.0.0.1:8000 으로 프록시한다.
#
#      로컬: http://localhost:8000/mcp
#      배포: http://<EC2_PUBLIC_IP>/mcp        (O)
#            http://<EC2_PUBLIC_IP>:8000/mcp   (X — 타임아웃)
MCP_SERVER_URL=http://localhost:8000/mcp

#    토큰 생성: openssl rand -hex 32
#    코드에 하드코딩 금지. 반드시 환경변수로만 주입한다.
MCP_AUTH_TOKEN=

# 4. LLM API Key (Vercel Server Side 전용)
#    NEXT_PUBLIC_ 접두사를 붙이면 Client Bundle에 노출된다.
OPENAI_API_KEY=

# 5. Docker 이미지 (팀원3이 EC2에서 사용)
#    MCP_IMAGE       -> /opt/mcp/image.env      (systemd가 읽음)
#    COLLECTOR_IMAGE -> /opt/mcp/collector.env  (cron이 읽음)
MCP_IMAGE=
COLLECTOR_IMAGE=

# 참고: 업비트 공개 API는 인증이 필요 없으므로 수집용 API Key는 없다.
