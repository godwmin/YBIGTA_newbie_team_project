# 이 파일을 복사해서 .env 로 만들고 값을 채우세요. (.env 는 절대 커밋 금지)
# cp .env.example .env

# ---- MySQL (로컬) ----
MYSQL_USER=root
MYSQL_PASSWORD=your_local_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ybigta

# ---- MySQL (AWS RDS 배포 시 위 값을 아래처럼 교체) ----
# MYSQL_HOST=<rds-endpoint>.ap-northeast-2.rds.amazonaws.com
# MYSQL_USER=admin
# MYSQL_PASSWORD=<rds-master-password>

# ---- MongoDB (팀원 2 담당) ----
# 로컬:  mongodb://localhost:27017/ybigta
# Atlas: mongodb+srv://<user>:<pw>@<cluster>.mongodb.net/ybigta?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017/ybigta
