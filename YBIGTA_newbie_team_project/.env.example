# ==========================================
# AI Agent 과제 환경변수 Template
# ==========================================

# 1. DB 설정 (AWS RDS / MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crypto_db

# 2. DB 계정 (팀원 1, 팀원 3 공유용)
COLLECTOR_DB_USER=collector_user
COLLECTOR_DB_PASSWORD=your_collector_password
MCP_DB_USER=mcp_user
MCP_DB_PASSWORD=your_mcp_password

# 3. MCP Server 설정 (팀원 1 & 팀원 2 통신용)
MCP_SERVER_URL=http://localhost:8000
MCP_AUTH_TOKEN=your_mcp_secret_token

# 4. LLM API Key (Vercel Agent Server Side용)
OPENAI_API_KEY=your_openai_api_key