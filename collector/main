import os
import requests
import pymysql
from datetime import datetime
from dotenv import load_dotenv

# .env 파일 로드
load_dotenv()

# DB 연결 정보 (환경변수에서 읽어옴)
DB_HOST = os.getenv("DB_HOST", "localhost")
DB_USER = os.getenv("COLLECTOR_DB_USER", "collector_user")
DB_PASSWORD = os.getenv("COLLECTOR_DB_PASSWORD", "your_password")
DB_NAME = os.getenv("DB_NAME", "crypto_db")
DB_PORT = int(os.getenv("DB_PORT", 3306))

# 수집할 주요 코인 목록
SYMBOLS = ["KRW-BTC", "KRW-ETH", "KRW-XRP", "KRW-SOL", "KRW-DOGE"]

def fetch_upbit_data():
    """업비트 API에서 현재가 데이터 수집"""
    url = f"https://api.upbit.com/v1/ticker?markets={','.join(SYMBOLS)}"
    headers = {"accept": "application/json"}
    
    response = requests.get(url, headers=headers)
    if response.status_code == 200:
        return response.json()
    else:
        print(f"API 요청 실패: {response.status_code}")
        return []

def save_to_db(data_list):
    """DB에 수집된 데이터 저장"""
    if not data_list:
        return

    # collected_at, created_at 타임스탬프 생성
    now = datetime.now()
    
    conn = pymysql.connect(
        host=DB_HOST,
        user=DB_USER,
        password=DB_PASSWORD,
        database=DB_NAME,
        port=DB_PORT,
        charset='utf8mb4'
    )
    
    try:
        with conn.cursor() as cursor:
            sql = """
            INSERT INTO coin_prices (symbol, price, change_rate, collected_at, created_at)
            VALUES (%s, %s, %s, %s, %s)
            """
            for item in data_list:
                market = item['market']            # 예: KRW-BTC
                trade_price = item['trade_price']  # 현재가
                signed_change_rate = item['signed_change_rate'] # 전일대비 변동률
                
                cursor.execute(sql, (market, trade_price, signed_change_rate, now, now))
            
            conn.commit()
            print(f"[{now}] 성공적으로 {len(data_list)}개 데이터 저장 완료!")
    except Exception as e:
        print(f"DB 저장 중 에러 발생: {e}")
    finally:
        conn.close()

if __name__ == "__main__":
    print("업비트 데이터 수집 시작...")
    data = fetch_upbit_data()
    
    # 1. 수집된 데이터 출력 확인
    print(f"수집 성공! 총 {len(data)}개 종목 데이터:")
    for item in data:
        print(f"- 종목: {item['market']}, 현재가: {item['trade_price']:,}원, 변동률: {item['signed_change_rate']*100:.2f}%")
    
    # 2. DB 저장 시도 (DB 연결 세팅 완료 시 실행됨)
    try:
        save_to_db(data)
    except Exception as e:
        print(f"\n[참고] DB 연결 실패 (팀원 3이 RDS 세팅 후 연결 예정): {e}")