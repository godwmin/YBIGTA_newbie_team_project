venv/
env/

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Editor settings
.vscode/
.idea/

# Crawler / processor logs
*.log

# Selenium 로그인 프로필 (쿠키·개인정보 포함, 커밋 금지)
.watcha_profile/
*_profile/
chromedriver*

# DB 접속 정보 (커밋 시 개인정보/과금 사고로 직결)
.env
.env.*
!.env.example

# SSH 키 / 인증서
*.pem
*.key
*.ppk

# ---------------------------------------------------------------------------
# Terraform (infra/terraform)
#   tfstate 에는 RDS 마스터 비밀번호가 평문으로 저장된다. 절대 커밋 금지.
# ---------------------------------------------------------------------------
.terraform/
# .terraform.lock.hcl 은 커밋한다 (팀원 간 provider 버전을 고정하기 위해)
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
override.tf
override.tf.json

# EC2에만 존재해야 하는 런타임 시크릿 (실수로 로컬에 만들었을 때 대비)
image.env
collector.env

# terraform plan 파일 (변수값=DB 비밀번호 포함)
tfplan
*.tfplan

# 팀 공유용 자격증명 메모 (평문 비밀번호 포함)
